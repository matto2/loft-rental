---
import { Image } from "astro:assets";
import Layout from "../layouts/MyLayout.astro";
import Grid from "../components/Grid.astro";
import heroImg from "../assets/IMG_0273.jpeg";
---

<Layout title="The Loft on King Street · Santa Cruz, CA">

  <!-- ── Hero ── -->
  <div class="hero relative overflow-hidden rounded-3xl mb-8 aspect-square md:aspect-auto md:h-screen md:rounded-none">
    <Image
      src={heroImg}
      alt="The Loft on King Street, Santa Cruz"
      class="w-full h-full object-cover object-center"
      loading="eager"
      widths={[800, 1200, 1920, 2560]}
      sizes="100vw"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 35%, transparent 60%)"></div>
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12 text-white" style="text-shadow: 0 1px 6px rgba(0,0,0,0.5);">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="bg-white/20 backdrop-blur-sm border border-white/30 text-white text-xs font-semibold px-3 py-1 rounded-full">
          Available July 2026
        </span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-2">
        The Loft on King Street
      </h1>
      <p class="text-white/80 text-sm md:text-lg">King St &nbsp;·&nbsp; Santa Cruz, CA 95060</p>
    </div>
  </div>

  <!-- ── Stats bar ── -->
  <div class="flex flex-wrap items-center justify-between gap-4 border border-stone-200 rounded-2xl px-6 py-4 mb-10 bg-white shadow-sm">
    <div class="flex flex-wrap gap-6 text-sm text-stone-500 divide-x divide-stone-200">
      <div class="pr-6">
        <span class="block text-2xl font-bold text-stone-900">$2,900</span>
        <span>per month</span>
      </div>
      <div class="px-6">
        <span class="block text-2xl font-bold text-stone-900">Loft</span>
        <span>1 bath</span>
      </div>
      <div class="px-6">
        <span class="block text-2xl font-bold text-stone-900">480</span>
        <span>sq ft</span>
      </div>
      <div class="px-6">
        <span class="block text-2xl font-bold text-stone-900">12</span>
        <span>month lease</span>
      </div>
    </div>
    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href="tel:+18312752566"
        class="bg-stone-900 text-white text-sm font-semibold py-2.5 px-5 rounded-xl hover:bg-stone-700 transition-colors text-center"
      >
        Call (831) 275-2566
      </a>
      <a
        href="mailto:mattosurf@gmail.com"
        class="border border-stone-300 text-stone-700 text-sm font-semibold py-2.5 px-5 rounded-xl hover:border-stone-500 transition-colors text-center"
      >
        Send Email
      </a>
    </div>
  </div>

  <!-- ── Body: two-column ── -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">

    <!-- Left: description -->
    <div class="lg:col-span-2 space-y-10">

      <section>
        <p class="text-lg leading-relaxed text-stone-700">
          A rare find on King Street — a beautifully renovated freestanding loft with soaring
          ceilings, skylights, and an open floor plan that lives larger than its square footage.
          Walk to downtown dining, reach the beach in minutes, and come home to your own private
          unit with all utilities included.
        </p>
        <a
          href="https://www.airbnb.com/rooms/7092117"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-col items-start gap-1.5 mt-4 bg-pink-500 hover:bg-pink-600 transition-colors text-white font-semibold px-5 py-3 rounded-xl"
        >
          <span class="flex gap-0.5 text-yellow-300 text-lg leading-none">★★★★★</span>
          <span class="text-base">See verified guest reviews on our Airbnb listing →</span>
        </a>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-3 pb-2 border-b border-stone-200">Ideal For</h2>
        <ul class="space-y-2 text-stone-600 text-sm">
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>1–2 people looking for a private, flexible space they can make their own</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Anyone who wants a freestanding unit — not part of a shared house</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Anyone wanting a simple all-in monthly cost with no bills to set up or split</span></li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-3 pb-2 border-b border-stone-200">The Space</h2>
        <p class="leading-relaxed text-stone-600 mb-4">
          High ceilings and skylights give the loft an open, airy feel. The layout has two
          distinct areas: an upstairs loft sleeping area and a separate downstairs space that
          works well as a second bedroom, office, or living room — flexible for roommates or
          solo use.
        </p>
        <ul class="space-y-2 text-stone-600 text-sm">
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Renovated kitchen with full-size gas range and overhead microwave</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Bathroom with deep soaker tub and shower</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Private mudroom with in-unit washer and dryer</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Ample storage throughout</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Available unfurnished — partial furnishing available on request</span></li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-3 pb-2 border-b border-stone-200">What's Included</h2>
        <p class="leading-relaxed text-stone-600 mb-4">
          All utilities are covered — no accounts to set up, no bills to split. One predictable monthly payment.
        </p>
        <div class="flex flex-wrap gap-2">
          {["⚡ Electricity", "🔥 Gas", "💧 Water", "♨️ Heat", "🗑️ Garbage Pickup"].map(u => (
            <span class="bg-stone-100 text-stone-700 text-sm font-medium px-3 py-1.5 rounded-full">{u}</span>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-3 pb-2 border-b border-stone-200">Why It Works</h2>
        <ul class="space-y-2.5 text-stone-600 text-sm">
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Private freestanding unit — your own space, not part of a shared house</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>All utilities included — one predictable monthly payment, nothing to set up</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>In-unit washer and dryer — no shared laundry</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Flexible two-area layout — works as two sleeping spaces or live/work setup</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Walkable to cafés, restaurants, and groceries on Mission St</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Downtown Santa Cruz about a mile away</span></li>
          <li class="flex gap-2"><span class="text-stone-400">—</span><span>Close to UCSC — ~5–10 min drive via Mission St</span></li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-3 pb-2 border-b border-stone-200">The Location</h2>
        <p class="text-stone-600 mb-4 leading-relaxed">
          On a quiet, tree-lined street — minutes from everything Santa Cruz has to offer.
        </p>
        <ul class="space-y-2.5 mb-6">
          {[
            ["1.1 mi", "to the Beach & Boardwalk"],
            ["1.0 mi", "to downtown Santa Cruz"],
            ["1.4 mi", "to UCSC (~5–10 min drive, bike-friendly via Mission St)"],
            ["Walking distance", "to cafés, restaurants & shops on Mission St"],
            ["Easy access", "to Highways 1 and 17"],
          ].map(([label, detail]) => (
            <li class="flex gap-3 items-baseline">
              <span class="font-semibold text-stone-900 text-sm whitespace-nowrap">{label}</span>
              <span class="text-stone-500 text-sm">{detail}</span>
            </li>
          ))}
        </ul>
        <div class="p-4 bg-stone-50 rounded-xl text-sm text-stone-600">
          <p class="font-semibold text-stone-800 mb-2">Parking</p>
          <ul class="space-y-1.5">
            <li class="flex gap-2"><span class="text-stone-400">—</span><span>Street parking available on the block</span></li>
            <li class="flex gap-2"><span class="text-stone-400">—</span><span>Permit-free spots on the intersecting street directly across from the unit</span></li>
            <li class="flex gap-2"><span class="text-stone-400">—</span><span>Westside residential permit easy to obtain if needed</span></li>
          </ul>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold mb-3 pb-2 border-b border-stone-200">Apply</h2>
        <p class="text-stone-600 text-sm mb-4">Download the rental application to get started. Reach out to schedule a showing or ask any questions.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/application.pdf"
            download
            class="inline-flex items-center gap-2 bg-stone-900 text-white text-sm font-semibold py-2.5 px-5 rounded-xl hover:bg-stone-700 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1M12 12v6m0 0l-3-3m3 3l3-3M12 3v9" />
            </svg>
            Download Application
          </a>
          <a
            href="https://www.places4students.com/dashboard/landlord/listings/268822/preview"
            class="inline-flex items-center gap-2 border border-stone-300 text-stone-700 text-sm font-semibold py-2.5 px-5 rounded-xl hover:border-stone-500 transition-colors"
          >
            View on Places4Students
          </a>
        </div>
      </section>

    </div>

    <!-- Right: sidebar -->
    <div class="space-y-5">

      <!-- Contact card -->
      <div class="border border-stone-200 rounded-2xl p-5 shadow-sm bg-white sticky top-6">
        <p class="text-sm text-stone-500 mb-1">Contact landlord</p>
        <p class="font-semibold text-stone-900 mb-1">Matthew O'Leary</p>
        <a
          href="https://linkedin.com/in/matt-oleary/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-800 transition-colors mb-4"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <div class="space-y-3">
          <a
            href="tel:+18312752566"
            class="flex items-center gap-3 bg-stone-900 text-white text-sm font-semibold py-3 px-4 rounded-xl hover:bg-stone-700 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            (831) 275-2566
          </a>
          <a
            href="mailto:mattosurf@gmail.com"
            class="flex items-center gap-3 border border-stone-300 text-stone-700 text-sm font-semibold py-3 px-4 rounded-xl hover:border-stone-500 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            mattosurf@gmail.com
          </a>
        </div>
        <p class="text-xs text-stone-400 mt-4 text-center">Rare private unit — reach out to schedule a showing.</p>
      </div>

      <!-- Property details card -->
      <div class="border border-stone-200 rounded-2xl p-5 bg-white">
        <p class="text-sm font-semibold text-stone-900 mb-4">Property Details</p>
        <dl class="space-y-2.5 text-sm">
          {[
            ["Type", "Freestanding Loft"],
            ["Rent", "$2,900 / month"],
            ["Deposit", "$2,900"],
            ["Lease", "12 months"],
            ["Available", "July 1, 2026"],
            ["Utilities", "All included"],
            ["Parking", "Street (permit-free nearby)"],
            ["Pets", "Cats welcome"],
          ].map(([label, value]) => (
            <div class="flex justify-between gap-2">
              <dt class="text-stone-400">{label}</dt>
              <dd class="font-medium text-stone-700 text-right">{value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Amenities card -->
      <div class="border border-stone-200 rounded-2xl p-5 bg-white">
        <p class="text-sm font-semibold text-stone-900 mb-4">Amenities</p>
        <ul class="grid grid-cols-2 gap-y-2.5 text-sm text-stone-600">
          {[
            "☀️ Skylights",
            "🏠 High Ceilings",
            "🛁 Soaker Tub",
            "🍳 Gas Kitchen",
            "🫧 Washer/Dryer",
            "🌿 Shared Patio",
            "📦 Mudroom",
            "🐱 Cats OK",
          ].map(a => <li>{a}</li>)}
        </ul>
      </div>

    </div>
  </div>

  <!-- ── Gallery ── -->
  <div class="mb-16">
    <h2 class="text-lg font-semibold mb-6 pb-2 border-b border-stone-200">Photos</h2>
    <Grid />
  </div>

  <!-- ── Bottom CTA ── -->
  <div class="mb-8 rounded-3xl bg-stone-900 text-white px-8 py-12 text-center">
    <h2 class="text-2xl font-bold mb-2">A rare private unit — typically rents quickly.</h2>
    <p class="text-stone-400 mb-8 max-w-md mx-auto">
      Freestanding, utilities included, and minutes from the beach and downtown. Reach out to schedule a showing or ask questions.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href="tel:+18312752566"
        class="bg-white text-stone-900 font-semibold py-3 px-8 rounded-xl hover:bg-stone-100 transition-colors"
      >
        Call (831) 275-2566
      </a>
      <a
        href="mailto:mattosurf@gmail.com"
        class="border border-white/40 text-white font-semibold py-3 px-8 rounded-xl hover:bg-white/10 transition-colors"
      >
        Send Email
      </a>
    </div>
  </div>

</Layout>
