<p class="mb-2 text-2xl font-bold">Reach out to us to schedule a tour!</p>
<p class="mb-2">Fill out the form below, or call/text Matt at (831) 275-2566</p>
<form
  name="contact"
  netlify
  class="max-w-md p-6 mb-12 bg-white shadow-md rounded-lg"
>
  <p class="mb-4">
    <label class="block text-gray-700 font-semibold mb-2">
      Name
      <input
        type="text"
        name="name"
        class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-500"
      />
    </label>
  </p>
  <p class="mb-4">
    <label class="block text-gray-700 font-semibold mb-2">
      Email
      <input
        type="email"
        name="email"
        class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-teal-500"
      />
    </label>
  </p>
  <p>
    <button
      type="submit"
      class="w-full bg-violet-600 text-white py-2 px-4 font-bold rounded-full hover:bg-red-700 transition text-lg"
    >
      Send
    </button>
  </p>
</form>
