---
import { Image, getImage } from "astro:assets";
import img1  from "../assets/IMG_0302.jpeg";
import img2  from "../assets/IMG_0265.jpeg";
import img3  from "../assets/IMG_0273.jpeg";
import img4  from "../assets/IMG_0263.jpeg";
import img5  from "../assets/IMG_0262.jpeg";
import img6  from "../assets/IMG_0276.jpeg";
import img7  from "../assets/IMG_0275.jpeg";
import img8  from "../assets/IMG_0294.jpeg";
import img9  from "../assets/IMG_0301.jpeg";
import img10 from "../assets/washer-dryer.jpg";

const photos = [
  { src: img1,  alt: "Soaring windows and blue sky" },
  { src: img2,  alt: "Loft sleeping area with skylights" },
  { src: img3,  alt: "Living room viewed from the loft above" },
  { src: img4,  alt: "Upstairs loft bedroom" },
  { src: img5,  alt: "Kitchen and dining area" },
  { src: img6,  alt: "Renovated kitchen with grey cabinetry" },
  { src: img7,  alt: "Open kitchen and dining from above" },
  { src: img8,  alt: "Renovated bathroom with subway tile" },
  { src: img9,  alt: "Light-filled interior with original artwork" },
  { src: img10, alt: "In-unit washer and dryer" },
];

const lbSrcs = await Promise.all(
  photos.map(p => getImage({ src: p.src, width: 2400, format: "webp" }).then(r => r.src))
);
---

<!-- ── Mobile: Swiper carousel ─────────────────────────────── -->
<div class="md:hidden swiper gallery-swiper overflow-hidden">
  <div class="swiper-wrapper">
    {photos.map((p, i) => (
      <div class="swiper-slide">
        <a href={lbSrcs[i]} class="glightbox block w-full h-72 gallery-item" data-gallery="loft">
          <Image src={p.src} alt={p.alt} class="w-full h-full object-cover" widths={[600,900]} sizes="100vw" />
        </a>
      </div>
    ))}
  </div>
  <div class="swiper-pagination"></div>
</div>

<!-- ── Desktop: editorial grid ────────────────────────────── -->
<div class="hidden md:grid md:grid-cols-12 gap-1 px-1">

  <!-- Row 1: Tall windows wide + loft skylights -->
  <a href={lbSrcs[0]} class="glightbox col-span-8 h-96 gallery-item" data-gallery="loft">
    <Image src={photos[0].src} alt={photos[0].alt} widths={[800,1200,1800]} sizes="66vw" />
  </a>
  <a href={lbSrcs[1]} class="glightbox col-span-4 h-96 gallery-item" data-gallery="loft">
    <Image src={photos[1].src} alt={photos[1].alt} widths={[600,900]} sizes="33vw" />
  </a>

  <!-- Row 2: Three loft/living shots -->
  <a href={lbSrcs[2]} class="glightbox col-span-4 h-80 gallery-item" data-gallery="loft">
    <Image src={photos[2].src} alt={photos[2].alt} widths={[600,900]} sizes="33vw" />
  </a>
  <a href={lbSrcs[3]} class="glightbox col-span-4 h-80 gallery-item" data-gallery="loft">
    <Image src={photos[3].src} alt={photos[3].alt} widths={[600,900]} sizes="33vw" />
  </a>
  <a href={lbSrcs[4]} class="glightbox col-span-4 h-80 gallery-item" data-gallery="loft">
    <Image src={photos[4].src} alt={photos[4].alt} widths={[600,900]} sizes="33vw" />
  </a>

  <!-- Row 3: Kitchen pair -->
  <a href={lbSrcs[5]} class="glightbox col-span-6 h-72 gallery-item" data-gallery="loft">
    <Image src={photos[5].src} alt={photos[5].alt} widths={[700,1000]} sizes="50vw" />
  </a>
  <a href={lbSrcs[6]} class="glightbox col-span-6 h-72 gallery-item" data-gallery="loft">
    <Image src={photos[6].src} alt={photos[6].alt} widths={[700,1000]} sizes="50vw" />
  </a>

  <!-- Row 4: Bathroom + character + laundry -->
  <a href={lbSrcs[7]} class="glightbox col-span-4 h-64 gallery-item" data-gallery="loft">
    <Image src={photos[7].src} alt={photos[7].alt} widths={[500,800]} sizes="33vw" />
  </a>
  <a href={lbSrcs[8]} class="glightbox col-span-4 h-64 gallery-item" data-gallery="loft">
    <Image src={photos[8].src} alt={photos[8].alt} widths={[500,800]} sizes="33vw" />
  </a>
  <a href={lbSrcs[9]} class="glightbox col-span-4 h-64 gallery-item" data-gallery="loft">
    <Image src={photos[9].src} alt={photos[9].alt} widths={[500,800]} sizes="33vw" />
  </a>

</div>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";
  import Swiper from "swiper";
  import { Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";

  GLightbox({
    selector: ".glightbox",
    touchNavigation: true,
    loop: true,
    closeButton: true,
    keyboardNavigation: true,
    closeOnOutsideClick: true,
  });

  new Swiper(".gallery-swiper", {
    modules: [Pagination],
    loop: true,
    slidesPerView: 1.15,
    centeredSlides: true,
    spaceBetween: 8,
    pagination: {
      el: ".gallery-swiper .swiper-pagination",
      clickable: true,
    },
  });
</script>

<style>
  .gallery-swiper {
    padding-bottom: 2rem;
  }
  .gallery-swiper .swiper-pagination-bullet {
    background: #8B7355;
    opacity: 0.4;
  }
  .gallery-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }
</style>
